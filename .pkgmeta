package-as: GryphonThreat

# Libraries embedded into the package. Locally, .tools/fetch-libs.cmd puts them into Libs/.
externals:
  Libs/LibStub:
    url: https://repos.curseforge.com/wow/libstub/trunk
    tag: 1.0
  Libs/LibEditMode:
    url: https://github.com/p3lim-wow/LibEditMode.git
    tag: latest

# Uploaded as the release notes on CurseForge, Wago Addons and GitHub.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Development files that are not part of the addon. Dotfiles (.github, .luacheckrc, ...) are
# ignored by the packager anyway.
ignore:
  - CLAUDE.md
  - README.md
  - docs
